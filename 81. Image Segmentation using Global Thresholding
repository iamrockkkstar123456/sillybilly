#Image segmentation using global thresholding
import numpy as np
import matplotlib.pyplot as plt
import cv2

#read the input image
img=cv2.imread('tiger.png')

if img is None:
    print("Error reading the image")
else:
    print("Image loaded")

#Histogram
plt.hist(img.ravel(), bins = 256, range =[0,255], color='red')
plt.title("Original Histogram")
plt.xlabel("Pixel Intensity-->")
plt.ylabel("No. of pixels nk-->")
plt.show()

#thresholding
T=150
ret, seg=cv2.threshold(img, T, 255,cv2.THRESH_BINARY)

plt.figure(1)

plt.subplot(1,2,1)
plt.imshow(img, cmap='gray')
plt.title("Input image")
plt.axis('off')

plt.subplot(1,2,2)
plt.imshow(seg, cmap='gray')
plt.title("Segmented image")
plt.axis('off')

plt.show()

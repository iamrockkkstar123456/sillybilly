#High Boost Filter
import cv2 as c
import matplotlib.pyplot as plt
import numpy as np

# Read image
Img = c.imread("C:\\Jay\\IPMV\\Exp5\\img.jpg", 0)

# Using in-built Gaussian Blur
Img1 = c.GaussianBlur(Img, (5, 5), 0)

# Mask (detail component)
Mask = Img - Img1

# High boost with k=2
High_boost1 = Img + 2 * Mask

# High boost with k=8
High_boost2 = Img + 8 * Mask

# Plot images
plt.subplot(1, 3, 1)
plt.title("Gaussian Blur Image")
plt.imshow(Img1, cmap="gray")

plt.subplot(1, 3, 2)
plt.imshow(High_boost1, cmap="gray")

plt.subplot(1, 3, 3)
plt.title("High Boost Image (k=8)")
plt.imshow(High_boost2, cmap="gray")

plt.show()

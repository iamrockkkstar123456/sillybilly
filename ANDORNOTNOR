# ==========================================
# 1. AND Gate
# ==========================================
print("--- AND Gate Training ---")
# Given parameters
w1 = 1.2
w2 = 0.6
learning_rate = 0.5
threshold = 1

# Activation function (step function)
def activation(net, thresh):
    return 1 if net >= thresh else 0

# AND gate training data
inputs_and = [(0, 0), (0, 1), (1, 0), (1, 1)]
targets_and = [0, 0, 0, 1]

# Training perceptron
epochs = 5
for epoch in range(epochs):
    print(f"Epoch {epoch + 1}")
    for i in range(len(inputs_and)):
        x1, x2 = inputs_and[i]
        target = targets_and[i]
        
        # Calculate net input
        net = x1 * w1 + x2 * w2
        
        # Get output
        output = activation(net, threshold)
        
        # Calculate error
        error = target - output
        
        # Update weights
        w1 = w1 + learning_rate * error * x1
        w2 = w2 + learning_rate * error * x2
        
        print(f"Input: ({x1}, {x2}), Output: {output}, Error: {error}")
        print(f"Updated weights: w1 = {w1:.1f}, w2 = {w2:.1f}")
    print("-" * 30)

# Final testing
print("Final AND gate outputs:")
for x1, x2 in inputs_and:
    net = x1 * w1 + x2 * w2
    output = activation(net, threshold)
    print(f"({x1}, {x2}) -> {output}")



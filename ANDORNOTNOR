# ==========================================
# 3. NOT Gate
# ==========================================
print("\n\n--- NOT Gate Training ---")
# Parameters for NOT gate (Only needs 1 weight)
w1 = 1.2
learning_rate = 0.5
# Adjusted threshold so it can fire on a '0' input without a bias term
threshold_not = -1 

# NOT gate training data
inputs_not = [(0,), (1,)]
targets_not = [1, 0]

# Training perceptron
epochs = 5
for epoch in range(epochs):
    print(f"Epoch {epoch + 1}")
    for i in range(len(inputs_not)):
        x1 = inputs_not[i][0]
        target = targets_not[i]
        
        net = x1 * w1 
        output = activation(net, threshold_not)
        error = target - output
        
        w1 = w1 + learning_rate * error * x1
        
        print(f"Input: ({x1}), Output: {output}, Error: {error}")
        print(f"Updated weights: w1 = {w1:.1f}")
    print("-" * 30)

print("Final NOT gate outputs:")
for (x1,) in inputs_not:
    net = x1 * w1
    output = activation(net, threshold_not)
    print(f"({x1}) -> {output}")

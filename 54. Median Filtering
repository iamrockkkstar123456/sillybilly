#Median Filtering
import cv2 as c
import matplotlib.pyplot as plt
import numpy as np

# Read image
Img = c.imread("C:\\Jay\\IPMV\\Exp5\\img.jpg", 0)

# Plot original image
plt.subplot(1, 2, 1)
plt.title("Original Image")
plt.imshow(Img, cmap="gray")
plt.axis('off')

# Median filter with kernel size 5
Img1 = c.medianBlur(Img, 5)

# Plot filtered image
plt.subplot(1, 2, 2)
plt.title("Median Filtered Image")
plt.imshow(Img1,cmap="gray")
plt.axis('off')

plt.show()

import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
import cv2

#load image
image=cv2.imread("cars.png")
image=cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

#reshape image pixels
pixels=image.reshape((-1, 3))

#apply KMeans (classify into 3 objects)
K=3
kmeans=KMeans(n_clusters = K, random_state = 42)
kmeans.fit(pixels)

#get labels
labels=kmeans.labels_

#reshape labels to image shape
segmented=labels.reshape(image.shape[:2])

#show original image
plt.subplot(1,2,1)
plt.imshow(image)
plt.title("Original image")
plt.axis('off')

#show segmented image
plt.subplot(1,2,2)
plt.imshow(segmented, cmap='viridis')
plt.title("Object classification using KMeans")
plt.axis('off')

plt.show()

# Image Averaging (Smoothing/LPF)
import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read the image
image = cv2.imread("C:\\Jay\\IPMV\\Exp5\\img.jpg", 0)

# Define Averaging kernels
avg_kernel_1 = (1/9) * np.ones((3,3)) # 3x3 kernel
avg_kernel_2 = (1/25)* np.ones((5,5)) # 5x5 kernel

#Apply Averaging filter
avg_image1 = cv2.filter2D(image, -1, avg_kernel_1)
avg_image2 = cv2.filter2D(image, -1, avg_kernel_2)

# Display images
plt.figure(figsize =(10,5))
plt.subplot(1,3,1)
plt.imshow(image, cmap='gray')
plt.title('Original Image')
plt.axis('off')

plt.subplot(1,3,2)
plt.imshow(avg_image1, cmap='gray')
plt.title('LPF Image (3x3 Kernel)')
plt.axis('off')

plt.subplot(1,3,3)
plt.imshow(avg_image2, cmap='gray')
plt.title('LPF Image (5x5 Kernel)')
plt.axis('off')
plt.show()

#perform intensity transformatin techniques
#point processing techniques
import numpy as np
import matplotlib.pyplot as plt
import cv2

#read the image
img=cv2.imread("photo.jpg")
if img is None:
    print("Error loading image")
else:
    print("Image loaded successfully")

r=cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

plt.figure(1)
plt.subplot(1,2,1)
plt.imshow(r, cmap='gray')
plt.title("Input image")
plt.axis("off")
#plt.show()

#perform image negative
L=256
s=(L-1)-r

plt.subplot(1,2,2)
plt.imshow(s, cmap='gray')
plt.title("Negativeimage")
plt.axis("off")
plt.show()

print('Pixels of Input Image')
print(r[10:50])
print('Pixels of Negative Image')
print(r[10:50])

#perform log transformation
rlog=np.log(1+r)
rlog=(rlog/np.max(rlog))*255 #normalization
log_img=rlog.astype(np.uint8) #convert image pixels into unit form

#display
plt.figure(2)
plt.subplot(1,2,1)
plt.imshow(r, cmap='gray')
plt.title("Input image")
plt.axis("off")
plt.subplot(1,2,2)
plt.imshow(log_img, cmap='gray')
plt.title('log image')
plt.axis("off")
plt.show()
